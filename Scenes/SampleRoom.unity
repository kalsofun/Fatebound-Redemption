  DialogueBox: {fileID: 239573384}
  charInfos:
  - name: "\u6E2C\u8005\u4E00"
    icon: {fileID: 1025558367}
    speak: 0
  - name: "\u6E2C\u8005\u4E8C"
    icon: {fileID: 660287184}
    speak: 1
  CharNameDisp: {fileID: 404371268}
  textEffects:
  - fullDialogue: "\u4E00\u822C\u4F86\u8B1B\uFF0C\u6211\u5011\u90FD\u5FC5\u9808\u52D9\u5FC5\u614E\u91CD\u7684\u8003\u616E\u8003\u616E\u3002"
    textSpeed: 30
    frequency: 0
    amplitude: 0
    CharHeadNum: 0
  - fullDialogue: "\u8981\u60F3\u6E05\u695A\uFF0C\u661F\u7A7A\uFF0C\u5230\u5E95\u662F\u4E00\u7A2E\u600E\u9EBC\u6A23\u7684\u5B58\u5728\u3002"
    textSpeed: 30
    frequency: 0
    amplitude: 0
    CharHeadNum: 0
  - fullDialogue: "\u661F\u7A7A\u7684\u610F\u7FA9\u5176\u5BE6\u5C31\u96B1\u85CF\u5728\u6211\u5011\u7684\u751F\u6D3B\u4E2D\uFF0C\u672C\u4EBA\u4E5F\u662F\u7D93\u904E\u4E86\u6DF1\u601D\u719F\u616E\uFF0C\u5728\u6BCF\u500B\u65E5\u65E5\u591C\u591C\u601D\u8003\u9019\u500B\u554F\u984C\u3002"
    textSpeed: 30
    frequency: 0
    amplitude: 0
    CharHeadNum: 1
  - fullDialogue: "\u5176\u5BE6\u661F\u7A7A\u662F\u975E\u5E38\u503C\u5F97\u6211\u5011\u6DF1\u601D\u7684\u3002"
    textSpeed: 30
    frequency: 0
    amplitude: 0
    CharHeadNum: 0
  - fullDialogue: "\u65E2\u7136\u662F\u9019\u6A23\uFF0C\u5FB7\u8B28\u514B\u5229\u7279\u66FE\u7D93\u8AAA\u904E\u4E00\u53E5\u767C\u4EBA\u6DF1\u7701\u7684\u8A71\uFF0C\u7BC0\u5236\u4F7F\u5FEB\u6A02\u589E\u52A0\u4E26\u4F7F\u4EAB\u53D7\u52A0\u5F37\u3002"
    textSpeed: 5
    frequency: 0
    amplitude: 0
    CharHeadNum: 1
  - fullDialogue: "\u9019\u53E5\u8A71\u8A9E\u96D6\u7136\u5F88\u77ED\uFF0C\u4F46\u4EE4\u6211\u6D6E\u60F3\u806F\u7FE9\u3002"
    textSpeed: 5
    frequency: 0
    amplitude: 0
    CharHeadNum: 0
  - fullDialogue: "\u6240\u4EE5\uFF0C\u6240\u4EE5\u8AAA\uFF0C\u6211\u5011\u4E00\u822C\u8A8D\u70BA\uFF0C\u6293\u4F4F\u4E86\u554F\u984C\u7684\u95DC\u9375\uFF0C\u5176\u4ED6\u4E00\u5207\u5247\u6703\u8FCE\u5203\u800C\u89E3\u3002"
    textSpeed: 30
    frequency: 30
    amplitude: 10
    CharHeadNum: 1
  - fullDialogue: "\u751F\u6D3B\u4E2D\uFF0C\u82E5\u661F\u7A7A\u51FA\u73FE\u4E86\uFF0C\u6211\u5011\u5C31\u4E0D\u5F97\u4E0D\u8003\u616E\u5B83\u51FA\u73FE\u4E86\u7684\u4E8B\u5BE6\u3002"
    textSpeed: 30
